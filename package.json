{
  "name": "soiduk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "stops": "node scripts/build-stops.mjs",
    "gtfs": "node scripts/build-gtfs.mjs",
    "setup": "node scripts/build-stops.mjs && node scripts/build-gtfs.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "fix": "biome check --write .",
    "check": "biome check . && tsc --noEmit && npm test",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.6",
    "lint-staged": "17.6.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "engines": {
    "node": ">=24"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
